{
    "version": "0.2.0",
    "configurations": [{
            "type": "lldb",
            "request": "launch",
            "name": "Debug Rust",
            "cargo": {
                "args": [
                    "build",
                    "--bin",
                    "your_binary_name"
                ]
            },
            "initCommands": [
                "script import sys; print('Python:', sys.version)",
                // Automatically loads rustc's natvis/pretty printers
                "command script import 2>/dev/null || true"
            ]
        },
        {
            "type": "chrome",
            "name": "AvaSim",
            "request": "launch",
            "url": "http://localhost:8000/index.html?debug=vscode"
        },
        // & "C:\Program Files\Google\Chrome\Application\chrome.exe" http://localhost:8000/index.html?debug=vscode --remote-debugging-port=9222 --user-data-dir="$(Get-Location).Path\chrome-debug-profile" --force_high_performance_gpu
        {
            "name": "Attach WebGPU Inspector",
            "type": "chrome", // Or "chrome" for older versions
            "request": "attach",
            "port": 9222, // Must match the port you used above
            "url": "http://localhost:8000/index.html?debug=vscode",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "name": "AvaSimSecure",
            "request": "launch",
            "url": "https://192.168.1.100/index.html?debug=vscode"
        }
    ],
    "python.defaultInterpreterPath": "C:\\git\\avalanchers\\.venv\\Scripts\\python.exe"
}